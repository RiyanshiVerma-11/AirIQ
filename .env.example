# ==============================================================================
# AirIQ CleanAir Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NOTE: .env is excluded by .gitignore and will NEVER be committed to Git.
# ==============================================================================

# Google Gemini API Key
# Obtain a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (Defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
VITE_GEMINI_MODEL=gemini-2.0-flash
